{
  "name": "openhole-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-docs": "mkdir -p content/docs && cp ../docs/*.md content/docs/",
    "sync-scripts": "for f in install uninstall; do test -f ../scripts/${f}.sh && cp ../scripts/${f}.sh public/${f}.sh && chmod +x public/${f}.sh; done; test -f ../scripts/install.ps1 && cp ../scripts/install.ps1 public/install.ps1",
    "prebuild": "npm run sync-version && npm run sync-scripts && npm run sync-docs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "sync-version": "node scripts/sync-version.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.43.0",
    "mdast-util-to-string": "^4.0.0",
    "motion": "^13.2.0",
    "next": "^16.3.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "simple-icons": "^16.30.0",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5"
  },
  "overrides": {
    "postcss": "8.5.23"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "postcss": "8.5.23",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
